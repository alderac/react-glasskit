{
  "name": "react-glasskit",
  "version": "1.0.3",
  "description": "Glass material primitives for React workspace interfaces",
  "keywords": [
    "react",
    "design-system",
    "glass",
    "glassmorphism",
    "ui",
    "css-modules",
    "typescript"
  ],
  "license": "MIT",
  "author": "Adam C. Alderson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alderac/react-glasskit.git"
  },
  "homepage": "https://alderac.github.io/react-glasskit",
  "bugs": {
    "url": "https://github.com/alderac/react-glasskit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs",
    "!docs/superpowers",
    "!docs/superpowers/**",
    "llms.txt",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css/components.css": "./dist/index.css",
    "./css/tokens.css": "./dist/css/tokens.css",
    "./css/tokens": "./dist/css/tokens.css",
    "./css/glass.module.css": "./dist/css/glass.module.css",
    "./css/glass": "./dist/css/glass.module.css"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json && node scripts/copy-dist-css.mjs && node scripts/assert-dist-package.mjs",
    "prepack": "npm run build",
    "audit:css": "node scripts/audit-css-fallbacks.mjs",
    "audit:themes": "node scripts/audit-theme-modes.mjs",
    "audit:geometry": "node scripts/audit-geometry.mjs",
    "audit:agents": "node scripts/audit-agent-visible-docs.mjs",
    "audit:package-docs": "node scripts/audit-package-docs.mjs",
    "audit:release-workflow": "node scripts/audit-release-workflow.mjs",
    "test": "vitest run",
    "smoke:package": "npm run build && node scripts/smoke-packed-vite.mjs",
    "smoke:next": "npm run build && node scripts/smoke-packed-next.mjs",
    "smoke:tailwind": "npm run build && node scripts/smoke-packed-tailwind.mjs",
    "smoke:demo": "npm --prefix demo run build && node scripts/smoke-demo-browser.mjs",
    "release:pack": "npm pack --dry-run",
    "release:check": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit:css && npm run audit:themes && npm run audit:geometry && npm run audit:agents && npm run audit:package-docs && npm run audit:release-workflow && npm run smoke:package && npm run smoke:next && npm run smoke:tailwind && npm run smoke:demo && npm run release:pack",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release:publish": "npm run release:check && changeset publish",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.4.0",
    "ultracite": "^7.7.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
